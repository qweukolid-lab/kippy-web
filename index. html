<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Kippy AI</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <style>
        :root {
            --bg: #000000;
            --card: #121212;
            --card-sec: #1a1a1a;
            --accent: #ff4b4b;
            --text: #ffffff;
            --text-muted: #888888;
            --border: #2a2a2a;
            --gold: #fbbf24;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; -webkit-tap-highlight-color: transparent; user-select: none; }
        
        body { background-color: var(--bg); color: var(--text); padding-bottom: 85px; overflow-x: hidden; }

        /* Утилиты */
        .tab-content { display: none; animation: fadeIn 0.2s ease-out forwards; }
        .tab-content.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        .hidden { display: none !important; }

        /* ================= ПРОФИЛЬ ================= */
        .profile-container { padding: 15px; }
        
        .profile-header { display: flex; align-items: center; gap: 15px; margin-bottom: 15px; position: relative; }
        .profile-avatar { width: 85px; height: 85px; border-radius: 50%; background: #222; display: flex; justify-content: center; align-items: center; font-size: 40px; position: relative; flex-shrink: 0; }
        .profile-avatar img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
        .status-dot { position: absolute; bottom: 4px; right: 4px; width: 14px; height: 14px; background: #4ade80; border-radius: 50%; border: 2px solid #000; }
        .edit-avatar-icon { position: absolute; bottom: 0; right: 0; background: #222; border-radius: 50%; width: 24px; height: 24px; display: flex; justify-content: center; align-items: center; border: 1px solid #444; }
        
        .profile-name-area { flex: 1; }
        .profile-name-area h2 { font-size: 22px; margin-bottom: 4px; display: flex; align-items: center; gap: 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .profile-name-area h2 i { color: var(--text-muted); font-size: 16px; }
        .profile-id { color: var(--text-muted); font-size: 13px; display: flex; align-items: center; gap: 5px; }
        .status-pill { background: #0f2e16; color: #4ade80; padding: 4px 10px; border-radius: 20px; font-size: 12px; display: inline-flex; align-items: center; gap: 5px; margin-top: 6px; border: 1px solid #1a4a2a;}
        
        .settings-gear { position: absolute; top: 0; right: 0; font-size: 24px; color: var(--text-muted); }

        /* Статистика */
        .profile-stats { display: flex; gap: 30px; margin-bottom: 15px; padding-left: 5px; }
        .stat-item { display: flex; flex-direction: column; align-items: center; font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
        .stat-item span { font-weight: bold; font-size: 20px; color: var(--text); margin-bottom: 2px; text-transform: none; letter-spacing: normal;}

        /* Био и Теги */
        .profile-bio { font-size: 14px; color: var(--text); margin-bottom: 12px; line-height: 1.4; }
        .profile-tags { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 15px; }
        .tag { background: var(--card-sec); padding: 6px 12px; border-radius: 20px; font-size: 13px; display: flex; align-items: center; gap: 5px; color: var(--text-muted); border: 1px solid var(--border); }

        /* Уровни */
        .levels-row { display: flex; gap: 10px; margin-bottom: 15px; }
        .level-badge { background: var(--card-sec); border: 1px solid var(--border); padding: 8px 15px; border-radius: 12px; font-size: 14px; display: flex; align-items: center; gap: 5px; }
        .level-add { background: var(--card-sec); border: 1px dashed var(--border); padding: 8px 15px; border-radius: 12px; font-size: 20px; display: flex; align-items: center; color: var(--text-muted); }

        /* 4 Виджета */
        .inventory-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 15px; }
        .inv-item { background: var(--card-sec); border-radius: 16px; padding: 15px 5px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; text-align: center; border: 1px solid var(--border); }
        .inv-item:active { transform: scale(0.95); }
        .inv-item i { font-size: 28px; margin-bottom: 8px; }
        .inv-item .val { font-size: 14px; font-weight: bold; color: white; margin-bottom: 2px; }
        .inv-item span { font-size: 11px; color: var(--text-muted); }

        /* Меню иконок */
        .action-menu { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin-bottom: 20px; border-bottom: 1px solid var(--border); padding-bottom: 15px; }
        .act-btn { display: flex; flex-direction: column; align-items: center; gap: 5px; font-size: 12px; color: var(--text-muted); }
        .act-btn i { font-size: 24px; color: white; }

        /* Вкладки */
        .profile-tabs { display: flex; background: var(--card-sec); border-radius: 30px; padding: 5px; margin-bottom: 15px; }
        .p-tab { flex: 1; text-align: center; padding: 10px 0; font-size: 14px; font-weight: 600; color: var(--text-muted); border-radius: 25px; cursor: pointer; }
        .p-tab.active { background: #2a2a2a; color: white; }
        
        .sub-tabs { display: flex; gap: 10px; margin-bottom: 15px; }
        .sub-tab { background: var(--card-sec); border: 1px solid var(--border); padding: 8px 16px; border-radius: 20px; font-size: 13px; font-weight: 600; color: var(--text-muted); cursor: pointer; }
        .sub-tab.active { background: white; color: black; border-color: white; }

        /* Пустой контейнер для ботов */
        .bots-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; min-height: 100px; }
        .empty-state { text-align: center; color: var(--text-muted); font-size: 14px; display: flex; justify-content: center; align-items: center; width: 100%; padding-top: 20px;}

        /* ================= ЭКРАН ПОДПИСКИ ================= */
        .shop-screen { padding: 20px; }
        .shop-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .shop-header i { font-size: 26px; cursor: pointer; }
        .coin-pill { background: var(--card-sec); padding: 8px 15px; border-radius: 20px; display: flex; align-items: center; gap: 6px; font-size: 14px; font-weight: bold; border: 1px solid var(--border);}
        
        .sub-tabs-shop { display: flex; background: var(--card-sec); border-radius: 20px; padding: 5px; margin-bottom: 20px; }
        .sub-tab-shop { flex: 1; text-align: center; padding: 12px 0; font-size: 15px; font-weight: 600; color: var(--text-muted); border-radius: 15px; }
        .sub-tab-shop.active { background: #2a2a2a; color: white; }

        .sub-prices { display: flex; gap: 10px; margin-bottom: 25px; }
        .sub-price-card { flex: 1; background: var(--card-sec); border-radius: 16px; padding: 15px 5px; text-align: center; border: 1px solid transparent; position: relative; }
        .sub-price-card.active { border-color: var(--accent); background: rgba(255, 75, 75, 0.05); }
        .sub-price-card .badge { position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: var(--accent); color: white; font-size: 10px; font-weight: bold; padding: 2px 8px; border-radius: 10px; }
        .sub-price-card .period { font-size: 12px; color: var(--text-muted); margin-bottom: 5px; }
        .sub-price-card .price { font-size: 16px; font-weight: bold; }
        .sub-price-card .old-price { font-size: 12px; color: #555; text-decoration: line-through; }
        
        .sub-features { display: flex; flex-direction: column; margin-bottom: 25px; background: var(--card); border-radius: 20px; padding: 0 15px; }
        .sub-feature-row { display: flex; justify-content: space-between; align-items: center; font-size: 14px; border-bottom: 1px solid #222; padding: 15px 0; color: var(--text-muted); }
        .sub-feature-row .feature-name { display: flex; align-items: center; gap: 10px; }
        .sub-feature-row .check { color: var(--accent); font-weight: bold; font-size: 18px; }
        
        .btn-action { background: var(--accent); color: white; border: none; border-radius: 16px; padding: 16px; width: 100%; font-size: 16px; font-weight: 600; cursor: pointer; }

        /* ================= СОЗДАНИЕ ================= */
        .create-screen { padding: 15px; }
        .create-header { display: flex; align-items: center; gap: 15px; margin-bottom: 20px; font-size: 20px; font-weight: bold; }
        .create-header i { font-size: 24px; }
        
        .upload-box { border: 2px dashed var(--border); border-radius: 16px; height: 160px; display: flex; flex-direction: column; justify-content: center; align-items: center; color: var(--text-muted); margin-bottom: 20px; background: var(--card-sec);}
        .upload-box i { font-size: 40px; margin-bottom: 10px; }
        
        .input-label { color: var(--text); margin-bottom: 8px; font-size: 15px; font-weight: 600;}
        .req { color: var(--accent); }
        .input-field { width: 100%; background: var(--card-sec); border: 1px solid var(--border); border-radius: 16px; padding: 15px; color: white; font-size: 15px; outline: none; margin-bottom: 5px; }
        .char-count { text-align: right; font-size: 12px; color: var(--text-muted); margin-bottom: 20px; display: block;}

        .radio-card { background: var(--card-sec); border: 1px solid var(--border); padding: 15px; border-radius: 16px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
        .radio-card.active { border-color: var(--accent); background: rgba(255,75,75,0.05); }
        .radio-card h4 { font-size: 16px; margin-bottom: 5px; }
        .radio-card p { font-size: 12px; color: var(--text-muted); }
        
        .checkbox-row { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; font-size: 14px; color: var(--text-muted); }
        .checkbox-box { width: 20px; height: 20px; background: var(--accent); border-radius: 4px; display: flex; justify-content: center; align-items: center; color: white;}

        .settings-dropdown { background: var(--card-sec); border: 1px solid var(--border); padding: 15px; border-radius: 16px; display: flex; justify-content: space-between; margin-bottom: 20px; font-size: 15px;}
        
        .warning-text { color: var(--text-muted); font-size: 12px; display: flex; align-items: flex-start; gap: 8px; margin-bottom: 20px; }
        
        .bottom-buttons { display: flex; gap: 10px; margin-top: 20px;}
        .btn-trash { background: var(--card-sec); border: 1px solid var(--border); width: 50px; height: 50px; border-radius: 16px; display: flex; justify-content: center; align-items: center; font-size: 20px; color: white; }
        .btn-save { background: var(--card-sec); border: 1px solid var(--border); flex: 1; border-radius: 16px; font-weight: 600; color: white; font-size: 16px; }
        .btn-publish { background: var(--accent); flex: 2; border-radius: 16px; font-weight: 600; color: white; font-size: 16px; border: none;}

        /* ================= ЧАТЫ ================= */
        .chats-top { display: flex; justify-content: space-between; align-items: center; padding: 15px; }
        .chat-tabs { display: flex; gap: 20px; font-size: 18px; font-weight: 700; }
        .chat-tab { color: var(--text-muted); }
        .chat-tab.active { color: var(--text); border-bottom: 2px solid var(--accent); padding-bottom: 2px; }
        .chat-header-icons { display: flex; gap: 15px; font-size: 24px; align-items: center;}
        
        .chat-list { padding: 0 15px; }
        /* Пустой список */

        /* ================= ВНУТРИ ЧАТА ================= */
        .chat-inner { display: flex; flex-direction: column; height: 100vh; padding-bottom: 140px; }
        .chat-top-bar { display: flex; justify-content: space-between; align-items: center; padding: 10px 15px; }
        .chat-top-bar i { font-size: 24px; }
        .chat-header-info { display: flex; align-items: center; gap: 10px; padding: 0 15px 15px 15px; border-bottom: 1px solid var(--border); }
        .chat-header-info img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; background: #333;}
        .chat-header-info h4 { font-size: 16px; display: flex; align-items: center; gap: 5px; }
        
        .chat-messages { flex: 1; padding: 15px; overflow-y: auto; }
        
        .chat-input-area { position: fixed; bottom: 75px; left: 0; width: 100%; padding: 10px 15px; background: var(--bg); }
        .chat-tools { display: flex; justify-content: space-between; margin-bottom: 10px; color: var(--text-muted); font-size: 20px; }
        .chat-input-box { display: flex; align-items: center; gap: 10px; background: var(--card-sec); border-radius: 20px; padding: 8px 15px; }
        .chat-input-box input { flex: 1; background: transparent; border: none; color: white; font-size: 15px; outline: none; }
        .chat-input-icons { display: flex; gap: 15px; font-size: 22px; color: var(--text-muted); }

        /* ================= НИЖНЕЕ МЕНЮ ================= */
        .bottom-nav { position: fixed; bottom: 0; left: 0; width: 100%; height: 70px; background: #000; border-top: 1px solid var(--border); display: flex; justify-content: space-around; align-items: center; z-index: 100; }
        .nav-item { color: var(--text-muted); font-size: 28px; display: flex; justify-content: center; align-items: center; width: 50px; height: 50px; }
        .nav-item.active { color: var(--text); }
        .nav-plus { width: 50px; height: 50px; background: var(--card-sec); border: 1px solid var(--border); border-radius: 12px; display: flex; justify-content: center; align-items: center; color: white; font-size: 24px; }
    </style>
</head>
<body>

    <!-- ================= ПРОФИЛЬ ================= -->
    <div id="tab-profile" class="tab-content active">
        <div class="profile-container">
            <div class="profile-header">
                <div class="profile-avatar">
                    <span id="prof-initial">U</span>
                    <div class="status-dot"></div>
                    <div class="edit-avatar-icon"><i class="ph ph-pencil-simple" style="font-size: 12px;"></i></div>
                </div>
                <div class="profile-name-area">
                    <h2 id="prof-name">Имя <i class="ph ph-pencil-simple"></i></h2>
                    <div class="profile-id" id="prof-username">@username</div>
                    <div class="status-pill"><i class="ph ph-planet"></i> Онлайн</div>
                </div>
                <i class="ph ph-gear settings-gear"></i>
            </div>

            <div class="profile-stats">
                <div class="stat-item"><span>0</span>Подписки</div>
                <div class="stat-item"><span>0</span>Подписки</div>
                <div class="stat-item"><span>0</span>Просмотры</div>
            </div>

            <div class="profile-bio">Описание профиля</div>
            
            <div class="profile-tags">
                <div class="tag"><i class="ph ph-gender-male"></i></div>
                <div class="tag"><i class="ph ph-map-pin"></i> RU</div>
                <div class="tag">Аниме</div>
                <div class="tag" style="margin-left:auto;"><i class="ph ph-caret-down"></i></div>
            </div>

            <div class="levels-row">
                <div class="level-badge"><i class="ph ph-shield"></i> ур.0</div>
                <div class="level-badge"><i class="ph ph-heart"></i> ур.0</div>
                <div class="level-add"><i class="ph ph-plus"></i></div>
            </div>

            <div class="inventory-grid">
                <div class="inv-item">
                    <i class="ph-fill ph-diamond" style="color: var(--accent);"></i>
                    <div class="val">Pro</div>
                    <span>Подписат...</span>
                </div>
                <div class="inv-item">
                    <i class="ph-fill ph-coin" style="color: var(--gold);"></i>
                    <div class="val">0</div>
                    <span>Монеты</span>
                </div>
                <div class="inv-item">
                    <i class="ph-fill ph-envelope-simple" style="color: #ec4899;"></i>
                    <div class="val">Пригласить</div>
                    <span>+320 монет</span>
                </div>
                <div class="inv-item">
                    <i class="ph-fill ph-diamond" style="color: #3b82f6;"></i>
                    <div class="val">0</div>
                    <span>Доходы</span>
                </div>
            </div>

            <div class="action-menu">
                <div class="act-btn"><i class="ph ph-bag" style="color: #d946ef;"></i>Сумка</div>
                <div class="act-btn"><i class="ph ph-clock-counter-clockwise" style="color: #3b82f6;"></i>История</div>
                <div class="act-btn"><i class="ph ph-star" style="color: #ff4b4b;"></i>Kippy+</div>
                <div class="act-btn"><i class="ph ph-gift" style="color: #d946ef;"></i>Стена</div>
                <div class="act-btn"><i class="ph ph-dots-three"></i>Ещё</div>
            </div>

            <div class="profile-tabs">
                <div class="p-tab" onclick="switchProfileTab(0)">Пост</div>
                <div class="p-tab active" onclick="switchProfileTab(1)">AI-боты</div>
                <div class="p-tab" onclick="switchProfileTab(2)">Новелла</div>
            </div>

            <div id="profile-content-bots">
                <div class="sub-tabs">
                    <div class="sub-tab active">Все</div>
                    <div class="sub-tab">Публичные</div>
                    <div class="sub-tab">Приватные</div>
                </div>
                <div class="bots-grid">
                    <div class="empty-state">Пусто</div>
                </div>
            </div>
            <div id="profile-content-empty" class="hidden">
                <div class="empty-state">Пока нет постов</div>
            </div>
        </div>
    </div>

    <!-- ================= МАГАЗИН ================= -->
    <div id="tab-shop" class="tab-content shop-screen">
        <div class="shop-header">
            <i class="ph ph-arrow-left" onclick="switchTab('profile')"></i>
            <div class="coin-pill">
                <i class="ph-fill ph-coin" style="color: var(--gold);"></i> <span>0</span> монет
            </div>
        </div>
        
        <div class="sub-tabs-shop">
            <div class="sub-tab-shop">Max</div>
            <div class="sub-tab-shop active">Pro</div>
        </div>

        <div class="sub-prices">
            <div class="sub-price-card">
                <div class="period">В месяц</div>
                <div class="price">1 190,00 ₽</div>
                <div class="old-price">39.67/day</div>
            </div>
            <div class="sub-price-card active">
                <div class="badge">Hot 🔥</div>
                <div class="period">В неделю</div>
                <div class="price">449,00 ₽</div>
            </div>
            <div class="sub-price-card">
                <div class="badge">19% OFF</div>
                <div class="period">В год</div>
                <div class="price">11 990,00 ₽</div>
                <div class="old-price">Р14833.17</div>
            </div>
        </div>

        <div class="sub-features">
            <div class="sub-feature-row">
                <div class="feature-name"><i class="ph ph-brain"></i> Память х5</div>
                <div class="check">✓</div>
            </div>
            <div class="sub-feature-row">
                <div class="feature-name"><i class="ph ph-chat-centered-text"></i> Ответы в 2 раза длиннее</div>
                <div class="check">✓</div>
            </div>
            <div class="sub-feature-row">
                <div class="feature-name"><i class="ph ph-lightbulb"></i> Умнее</div>
                <div class="check">✓</div>
            </div>
            <div class="sub-feature-row">
                <div class="feature-name"><i class="ph ph-prohibit"></i> Без рекламы</div>
                <div class="check">✓</div>
            </div>
            <div class="sub-feature-row">
                <div class="feature-name"><i class="ph ph-gift"></i> Бесконечные сообщения</div>
                <div class="check">✓</div>
            </div>
            <div class="sub-feature-row">
                <div class="feature-name"><i class="ph ph-percent"></i> Скидки на токены</div>
                <div class="check">10%</div>
            </div>
        </div>

        <div style="background: #121212; padding: 20px; border-radius: 20px; margin-bottom: 20px; border: 1px solid #2a2a2a;">
             <h3 style="margin-bottom: 15px; font-size: 16px;">Покупка токенов</h3>
             <button class="btn-action" style="margin-bottom: 10px;">50 000 токенов - 150 ₽</button>
             <button class="btn-action">100 000 токенов - 250 ₽</button>
        </div>

        <button class="btn-action">Подписаться</button>
    </div>

    <!-- ================= СОЗДАНИЕ ================= -->
    <div id="tab-create" class="tab-content create-screen">
        <div class="create-header">
            <i class="ph ph-arrow-left" onclick="switchTab('profile')"></i>
            Создать персонажа
        </div>
        
        <div class="upload-box">
            <i class="ph ph-image"></i>
            <span>AI-аватар</span>
        </div>

        <p class="input-label">Имя персонажа <span class="req">*</span></p>
        <input type="text" class="input-field" placeholder="Введите имя">
        <span class="char-count">0/60</span>

        <p class="input-label">Первое сообщение <span class="req">*</span></p>
        <textarea class="input-field" rows="3" placeholder="Придумайте первые слова, с которых ваш AI будет начинать каждый чат."></textarea>

        <p class="input-label" style="margin-top: 20px;">Кто может это видеть?</p>
        <div class="radio-card active">
            <div>
                <h4>Публичный</h4>
                <p>Любой может найти и использовать</p>
            </div>
            <i class="ph-fill ph-check-circle" style="color: var(--accent); font-size: 24px;"></i>
        </div>
        <div class="radio-card">
            <div>
                <h4>Личный</h4>
                <p>Только у вас есть доступ</p>
            </div>
        </div>

        <div class="checkbox-row">
            <div class="checkbox-box"><i class="ph ph-check"></i></div>
            Синхронизировать с моими публикациями для большего охвата
        </div>

        <p class="input-label">Описание персонажа</p>
        <textarea class="input-field" rows="4" placeholder="Добавьте краткое описание вашего AI"></textarea>

        <div class="settings-dropdown">
            <div style="display: flex; align-items: center; gap: 10px;">
                <i class="ph ph-sliders-horizontal"></i> Дополнительные настройки
            </div>
            <i class="ph ph-caret-down"></i>
        </div>

        <div class="warning-text">
            <i class="ph ph-warning-circle" style="font-size: 20px;"></i>
            <span>Все персонажи на платформе по умолчанию считаются взрослыми (18 лет и старше).</span>
        </div>

        <div class="bottom-buttons">
            <div class="btn-trash"><i class="ph ph-trash"></i></div>
            <button class="btn-save">Сохранить</button>
            <button class="btn-publish">Опубликовать</button>
        </div>
    </div>

    <!-- ================= ЧАТЫ ================= -->
    <div id="tab-chats" class="tab-content">
        <div class="chats-top">
            <div class="chat-tabs">
                <div class="chat-tab active">AI</div>
                <div class="chat-tab">Живые</div>
            </div>
            <div class="chat-header-icons">
                <div class="status-pill" style="margin:0; padding: 5px 10px;"><i class="ph ph-planet"></i> Онлайн</div>
                <i class="ph ph-bell"></i>
                <i class="ph ph-plus-circle"></i>
            </div>
        </div>
        <div class="chat-list">
            <div class="empty-state">Нет чатов</div>
        </div>
    </div>

    <!-- ================= ВНУТРИ ЧАТА ================= -->
    <div id="tab-chat-inner" class="tab-content chat-inner">
        <div class="chat-top-bar">
            <i class="ph ph-arrow-left" onclick="switchTab('chats')"></i>
            <div style="display:flex; gap:10px; align-items:center;">
                <div style="background:#1a1a1a; padding: 5px 10px; border-radius: 20px; font-size: 12px; border: 1px solid #333; display:flex; align-items:center; gap:5px;">
                    <i class="ph ph-gift" style="color: var(--accent);"></i> 02:12:19
                </div>
                <div style="background:#1a1a1a; padding: 5px 10px; border-radius: 20px; font-size: 12px; border: 1px solid #333; display:flex; align-items:center; gap:5px;">
                    <i class="ph-fill ph-heart" style="color: var(--accent);"></i> Ур. 2
                </div>
                <span style="color: var(--accent); font-weight: bold; font-style: italic; margin-left: 5px;">VIP</span>
            </div>
            <i class="ph ph-dots-three-vertical"></i>
        </div>
        
        <div class="chat-header-info">
            <img src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='40' height='40' viewBox='0 0 40 40'><rect width='40' height='40' fill='%23333'/><circle cx='20' cy='15' r='8' fill='%23666'/><path d='M5 40 Q20 20 35 40' fill='%23666'/></svg>" alt="avatar">
            <h4>Имя персонажа <i class="ph ph-caret-down"></i></h4>
        </div>

        <div class="chat-messages">
            <!-- Пустая зона для сообщений -->
        </div>

        <div class="chat-input-area">
            <div class="chat-tools">
                <div style="display:flex; gap:15px;">
                    <i class="ph ph-pencil-simple"></i>
                    <i class="ph ph-sparkle"></i>
                    <i class="ph ph-arrows-clockwise"></i>
                </div>
                <div style="display:flex; gap:15px;">
                    <i class="ph ph-camera"></i>
                    <i class="ph ph-image"></i>
                    <i class="ph ph-video-camera"></i>
                </div>
            </div>
            <div class="chat-input-box">
                <div class="chat-input-icons">
                    <i class="ph ph-user"></i>
                    <i class="ph ph-fire" style="color: #f97316;"></i>
                </div>
                <input type="text" placeholder="Введите сообщение">
                <div class="chat-input-icons">
                    <i class="ph ph-smiley"></i>
                    <i class="ph ph-play"></i>
                    <i class="ph ph-plus-circle" style="color: var(--accent);"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= НИЖНЕЕ МЕНЮ ================= -->
    <div class="bottom-nav">
        <div class="nav-item" id="nav-search" onclick="switchTab('search')"><i class="ph ph-house"></i></div>
        <div class="nav-item" id="nav-chats" onclick="switchTab('chats')"><i class="ph ph-chat-circle-dots"></i></div>
        <div class="nav-plus" onclick="switchTab('create')"><i class="ph ph-plus"></i></div>
        <div class="nav-item active" id="nav-profile" onclick="switchTab('profile')"><i class="ph ph-user"></i></div>
    </div>

    <script>
        // Инициализация Telegram WebApp
        const tg = window.Telegram.WebApp;
        tg.expand();
        tg.setHeaderColor('#000000');
        tg.setBackgroundColor('#000000');

        // Загрузка данных из Telegram
        const user = tg.initDataUnsafe?.user;
        if (user) {
            document.getElementById('prof-name').innerHTML = `${user.first_name || "Имя"} <i class="ph ph-pencil-simple"></i>`;
            document.getElementById('prof-username').innerText = user.username ? '@' + user.username : 'ID: ' + user.id;
            if (user.photo_url) {
                // Если есть аватарка, подставляем её
                const img = document.createElement('img');
                img.src = user.photo_url;
                const container = document.querySelector('.profile-avatar');
                container.innerHTML = '';
                container.appendChild(img);
                
                // Возвращаем индикатор онлайна
                const dot = document.createElement('div');
                dot.className = 'status-dot';
                container.appendChild(dot);
                
                // Возвращаем иконку редактирования
                const edit = document.createElement('div');
                edit.className = 'edit-avatar-icon';
                edit.innerHTML = '<i class="ph ph-pencil-simple" style="font-size: 12px;"></i>';
                container.appendChild(edit);
            } else {
                document.getElementById('prof-initial').innerText = (user.first_name || "U").charAt(0);
            }
        }

        // Переключение экранов
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            const target = document.getElementById('tab-' + tabId);
            if(target) target.classList.add('active');
            
            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
            if(tabId === 'profile') document.getElementById('nav-profile').classList.add('active');
            if(tabId === 'chats' || tabId === 'chat-inner') document.getElementById('nav-chats').classList.add('active');
            if(tabId === 'search') document.getElementById('nav-search').classList.add('active');
        }

        // Переключение вкладок внутри профиля
        function switchProfileTab(index) {
            document.querySelectorAll('.p-tab').forEach((t, i) => {
                if(i === index) t.classList.add('active');
                else t.classList.remove('active');
            });
            
            const botsContent = document.getElementById('profile-content-bots');
            const emptyContent = document.getElementById('profile-content-empty');
            
            if(index === 1) {
                botsContent.classList.remove('hidden');
                emptyContent.classList.add('hidden');
            } else {
                botsContent.classList.add('hidden');
                emptyContent.classList.remove('hidden');
            }
        }
    </script>
</body>
</html>
